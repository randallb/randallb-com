; Function-valued calls use pair closures; ordinary named calls remain direct.
(def sc-variable (x)
  (if x (if (id x t) nil
    (if (id (type x) 'symbol)
      (if (sc-member x '(if fn def quote lit)) nil
        (if (nom x) (sc-name-chars (nom x)) nil)) nil)) nil))
(def sc-primitive-name (x) (sc-member x '(join id car cdr type nom sym err)))
(def sc-primitives () '((join a d) (id a b) (car x) (cdr x) (type x) (nom x) (sym x) (err x)))
(def sc-append (a b) (if a (join (car a) (sc-append (cdr a) b)) b))
(def sc-access (x ctx)
  (if ctx (if (id x (car (car ctx))) (cdr (car ctx)) (sc-access x (cdr ctx))) nil))
(def sc-local-context (params)
  (if params
    (join (join (car params) (sc-l3 "(local.get $p-" (nom (car params)) ")"))
      (sc-local-context (cdr params))) nil))
(def sc-capture-context (ctx)
  (if ctx
    (join (join (car (car ctx))
      (sc-l3 "(call $lookup " (sc-constant (car (car ctx))) " (local.get $env))"))
      (sc-capture-context (cdr ctx))) nil))
(def sc-lambda-context (params ctx)
  (sc-append (sc-local-context params) (sc-capture-context ctx)))
(def sc-environment (ctx)
  (if ctx
    (sc-l6 "(call $join (call $join " (sc-constant (car (car ctx))) " "
      (cdr (car ctx)) ") " (sc-l2 (sc-environment (cdr ctx)) ")"))
    "(i32.const 0)"))
(def sc-function-value (name) (sc-l3 "(global.get $fun-" (nom name) ")"))
(def sc-indirect (x ctx forms path)
  (sc-l5 "(call $apply " (sc-expr (car x) ctx forms (join \f path)) " "
    (sc-argument-list (cdr x) ctx forms path) ")"))
(def sc-argument-list (xs ctx forms path)
  (if xs (if (id (type xs) 'pair)
    (sc-l5 "(call $join " (sc-expr (car xs) ctx forms (join \a path)) " "
      (sc-argument-list (cdr xs) ctx forms (join \d path)) ")") (sc-reject))
    "(i32.const 0)"))
(def sc-if (xs ctx forms path)
  (if xs (if (id (type xs) 'pair)
    (if (cdr xs)
      (if (id (type (cdr xs)) 'pair)
        (sc-l6 "(if (result i32) " (sc-expr (car xs) ctx forms (join \a path)) " (then "
          (sc-expr (sc-second xs) ctx forms (join \a (join \d path))) ") (else "
          (sc-l2 (sc-if (cdr (cdr xs)) ctx forms (join \d (join \d path))) "))"))
        (sc-reject))
      (sc-expr (car xs) ctx forms (join \a path))) (sc-reject)) "(i32.const 0)"))
; Validate dynamic arity before reading the arguments. Named direct arities are static.
(def sc-check-args (params arg)
  (if params
    (sc-l5 "(if (i32.eqz (call $pairp " arg ")) (then unreachable)) "
      (sc-check-args (cdr params) (sc-l3 "(call $cdr " arg ")")) " ")
    (sc-l3 "(if " arg " (then unreachable)) ")))
(def sc-wrapper-args (params arg)
  (if params (sc-l5 " (call $car " arg ") "
    (sc-wrapper-args (cdr params) (sc-l3 "(call $cdr " arg ")")) " ") nil))
(def sc-locals (params)
  (if params (sc-l4 "(local $p-" (nom (car params)) " i32) " (sc-locals (cdr params))) nil))
(def sc-unpack (params arg)
  (if params (sc-l6 "(local.set $p-" (nom (car params)) " (call $car " arg ")) "
    (sc-unpack (cdr params) (sc-l3 "(call $cdr " arg ")"))) nil))
(def sc-code-global (name mode)
  (if mode
    (sc-l3 "(global.set $code-" name " (call $join (i32.const 0) (i32.const 0))) ")
    (sc-l3 "(global $code-" name " (mut i32) (i32.const 0)) ")))
(def sc-named-global (name mode)
  (sc-l2 (sc-code-global (sc-l2 "named-" (nom name)) mode)
    (if mode
      (sc-l5 "(global.set $fun-" (nom name) " (call $closure (global.get $code-named-"
        (nom name) ") (i32.const 0))) ")
      (sc-l3 "(global $fun-" (nom name) " (mut i32) (i32.const 0)) "))))
(def sc-function-globals (forms mode)
  (if forms (sc-l2 (sc-named-global (sc-second (car forms)) mode)
    (sc-function-globals (cdr forms) mode)) nil))
(def sc-primitive-globals (ps mode)
  (if ps (sc-l2 (sc-named-global (car (car ps)) mode)
    (sc-primitive-globals (cdr ps) mode)) nil))
(def sc-wrappers (forms)
  (if forms
    (sc-l6 "(func $wrap-" (nom (sc-second (car forms)))
      " (param $env i32) (param $args i32) (result i32) "
      (sc-check-args (sc-third (car forms)) "(local.get $args)")
      (sc-l4 "(call $bel-" (nom (sc-second (car forms)))
        (sc-wrapper-args (sc-third (car forms)) "(local.get $args)") ")) ")
      (sc-wrappers (cdr forms))) nil))
(def sc-primitive-wrappers (ps)
  (if ps
    (sc-l6 "(func $wrap-" (nom (car (car ps)))
      " (param $env i32) (param $args i32) (result i32) "
      (sc-check-args (cdr (car ps)) "(local.get $args)")
      (sc-l4 "(call $" (nom (car (car ps)))
        (sc-wrapper-args (cdr (car ps)) "(local.get $args)") ")) ")
      (sc-primitive-wrappers (cdr ps))) nil))
; A syntax path gives each lambda a stable internal name, without numeric counters.
(def sc-lambda-item (x ctx forms path mode)
  (if (sc-three x)
    (if (sc-params (sc-second x) forms)
      (if (id mode 'global) (sc-code-global path nil)
        (if (id mode 'init) (sc-code-global path t)
          (if (id mode 'dispatch) (sc-dispatch-item path (sc-l2 "lambda-" path))
            (sc-l6 "(func $lambda-" path " (param $env i32) (param $args i32) (result i32) "
              (sc-locals (sc-second x))
              (sc-l3 (sc-check-args (sc-second x) "(local.get $args)")
                (sc-unpack (sc-second x) "(local.get $args)")
                (sc-expr (sc-third x) (sc-lambda-context (sc-second x) ctx) forms (join \b path))) ") "))))
      (sc-reject)) (sc-reject)))
(def sc-lambda-scan (x ctx forms path mode)
  (if (id (type x) 'pair)
    (if (if (sc-integer x) t (sc-chars x)) nil
      (if (id (car x) 'quote) nil
        (if (id (car x) 'fn)
          (sc-l2 (sc-lambda-item x ctx forms path mode)
            (sc-lambda-scan (sc-third x) (sc-lambda-context (sc-second x) ctx)
              forms (join \b path) mode))
          (sc-l2 (sc-lambda-scan (car x) ctx forms (join \f path) mode)
            (sc-lambda-args (cdr x) ctx forms path mode))))) nil))
(def sc-lambda-args (xs ctx forms path mode)
  (if xs (if (id (type xs) 'pair)
    (sc-l2 (sc-lambda-scan (car xs) ctx forms (join \a path) mode)
      (sc-lambda-args (cdr xs) ctx forms (join \d path) mode)) (sc-reject)) nil))
(def sc-lambda-forms (forms all mode)
  (if forms
    (sc-l2 (sc-lambda-scan (sc-fourth (car forms)) (sc-local-context (sc-third (car forms)))
      all (join \_ (nom (sc-second (car forms)))) mode)
      (sc-lambda-forms (cdr forms) all mode)) nil))
(def sc-dispatch-item (code target)
  (sc-l5 "(if (i32.eq (local.get $code) (global.get $code-" code
    ")) (then (return (call $" target " (local.get $env) (local.get $args))))) "))
(def sc-dispatch-named (forms)
  (if forms
    (sc-l2 (sc-dispatch-item (sc-l2 "named-" (nom (sc-second (car forms))))
      (sc-l2 "wrap-" (nom (sc-second (car forms))))) (sc-dispatch-named (cdr forms))) nil))
(def sc-dispatch-primitives (ps)
  (if ps (sc-l2 (sc-dispatch-item (sc-l2 "named-" (nom (car (car ps))))
    (sc-l2 "wrap-" (nom (car (car ps))))) (sc-dispatch-primitives (cdr ps))) nil))
(def sc-dispatch (forms)
  (sc-l6 (sc-l2 (sc-l2 "(func $apply (param $fn i32) (param $args i32) (result i32) " (sc-l2 "(local $code i32) (local $env i32)
    (if (i32.ne (call $ca" "r (local.get $fn)) (global.get $call-marker)) (then unreacha")) (sc-l2 "ble))
    (local.set $code (call $car (call $cdr (local.get " (sc-l2 "$fn))))
    (local.set $env (call $cdr (call $cdr (local.get" " $fn)))) ")))
    (sc-dispatch-named forms) (sc-dispatch-primitives (sc-primitives))
    (sc-lambda-forms forms forms 'dispatch) " unreachable) " nil))

(def sc-higher-runtime ()
  (sc-l2 (sc-l2 (sc-l2 (sc-l2 "(global $call-marker (mut i32) (i32.const 0))
(func $closure" " (param $c") (sc-l2 "ode i32) (param $env i32) (result i32)
 (call $join (global." "get $call-")) (sc-l2 (sc-l2 "marker) (call $join (local.get $code) (local.get $env))))
(f" "unc $looku") (sc-l2 "p (param $name i32) (param $env i32) (result i32)
 (local $e" "ntry i32)
"))) (sc-l2 (sc-l2 (sc-l2 " (block $missing (loop $scan
  (br_if $missing (i32.eqz (loc" "al.get $en") (sc-l2 "v)))
  (local.set $entry (call $car (local.get $env)))
  (if" " (i32.eq (")) (sc-l2 (sc-l2 "local.get $name) (call $car (local.get $entry)))
   (then (r" "eturn (cal") (sc-l2 (sc-l2 "l $cdr (local.get $entry)))))
  (local.set $env (call $cdr (" "local.get ") "$env))) (br $scan))) unreachable)
")))))

(def sc-name-export ()
 (sc-l2 "(func (export \"symbolname\") (param $x i32) (result i32) "
         "(call $nom (local.get $x)))"))

(def sc-symbol-runtime ()
 (sc-l2 "(func $sym (param $x i32) (result i32) "
         "(call $intern (local.get $x)))"))
