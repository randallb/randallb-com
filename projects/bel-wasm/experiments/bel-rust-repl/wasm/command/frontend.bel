(def rbel-core (request)
  (if (id (car request) 'scan-unit) (mod-scan-unit (sc-second request))
    (id (car request) 'read-unit) (mod-read-unit (sc-second request))
    (id (car request) 'read-bundle) (rbel-read-units (sc-third (sc-second request)))
    (id (car request) 'compile-bundle) (mod-compile-bundle (sc-second request))
    (id (car request) 'check-bundle) (mod-check-bundle (sc-second request))
    (id (car request) 'read) (rn-read-all (sc-second request))
    (id (car request) 'compile) (sc-compile (rn-read-all (sc-second request)))
    (id (car request) 'check)
      (sc-compile (rbel-test-module (rn-read-all (sc-second request))
                                  (rn-read-all (sc-third request))))
    (err 'unknown-core-request)))
(def rbel-read-units (units)
  (if units (n-append (rbel-unlocated (mod-read-unit (car units)))
    (rbel-read-units (cdr units))) nil))
(def rbel-unlocated (rows)
  (if rows
    (if (if (id (type (car (car rows))) 'pair)
          (sc-member (car (car (car rows))) '(module import export)) nil)
      (rbel-unlocated (cdr rows))
      (join (car (car rows)) (rbel-unlocated (cdr rows)))) nil))
(def rbel-test-module (forms rows)
  (join (sc-l4 'def 'rbel-internal-check '(selector) (rbel-test-body rows))
    (join '(def rbel-internal-equal (a b)
             (if (id a b) t
               (if (id (type a) 'pair)
                 (if (id (type b) 'pair)
                   (if (rbel-internal-equal (car a) (car b))
                       (rbel-internal-equal (cdr a) (cdr b)) nil) nil) nil)))
          forms)))
(def rbel-test-body (rows)
  (if rows
    (if (sc-three (car rows))
      (if (id (type (car (car rows))) 'symbol)
        (sc-l4 'if (sc-l3 'id 'selector (sc-l2 'quote (car (car rows))))
          (sc-l4 'if
            (sc-l3 'rbel-internal-equal (sc-second (car rows))
              (sc-l2 'quote (sc-third (car rows)))) t nil)
          (rbel-test-body (cdr rows)))
        (err 'bad-example-name)) (err 'bad-example-shape))
    (sc-l2 'err (sc-l2 'quote 'unknown-example))))
