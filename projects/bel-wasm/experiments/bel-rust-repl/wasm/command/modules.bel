; Source-unit parsing and namespace linking. Hosts supply bytes/identity, never semantics.
(def mod-second (x) (car (cdr x)))
(def mod-third (x) (car (cdr (cdr x))))
(def mod-fourth (x) (car (cdr (cdr (cdr x)))))
(def mod-fifth (x) (car (cdr (cdr (cdr (cdr x))))))
(def mod-sixth (x) (car (cdr (cdr (cdr (cdr (cdr x)))))))
(def mod-list (x)
  (if x (if (id (type x) 'pair) (mod-list (cdr x)) nil) t))
(def mod-chars (x)
  (if x (if (id (type x) 'pair)
    (if (id (type (car x)) 'char) (mod-chars (cdr x)) nil) nil) t))
(def mod-at-least (x budget)
  (if budget (if (id (type x) 'pair) (mod-at-least (cdr x) (cdr budget)) nil) (mod-list x)))
(def mod-origin (label line name) (sc-l3 label line name))
(def mod-detail (x)
  (if (id (type x) 'symbol) (nom x) (if (mod-chars x) x "invalid value")))
(def mod-fail (origin message detail)
  (err (n-append (car origin) (n-append ":" (n-append (mod-second origin)
    (n-append ": " (n-append (if (mod-third origin) (n-append (nom (mod-third origin)) ": ") nil)
      (n-append message
      (if detail (n-append ": " (mod-detail detail)) nil)))))))))
(def mod-unknown () (mod-origin "<source-bundle>" "0" nil))
(def mod-line-after (source remaining line)
  (if (id source remaining) line
    (if source (mod-line-after (cdr source) remaining
      (if (id (car source) \lf) (n-add line "1") line))
      (mod-fail (mod-unknown) "invalid consumed source tail" nil))))
(def mod-form-name (form)
  (if (id (type form) 'pair)
    (if (id (car form) 'def) (if (id (type (mod-second form)) 'symbol) (mod-second form) nil) nil) nil))
(def mod-read-form (source origin)
  (try (rn-one source)
    (catch problem (mod-fail origin "while reading form" problem))))
(def mod-read-forms (source label line)
  (mod-read-forms-loop source label line nil))
(def mod-read-forms-loop (source label line out)
  (mod-read-skipped source (rn-skip source) label line out))
(def mod-read-skipped (source skipped label line out)
  (if skipped
    (mod-read-next skipped label (mod-line-after source skipped line) out)
    (n-reverse out nil)))
(def mod-read-next (source label line out)
  (mod-read-after source label line out (mod-read-form source (mod-origin label line nil))))
(def mod-read-after (source label line out parsed)
  (mod-read-forms-loop (cdr parsed) label (mod-line-after source (cdr parsed) line)
    (join (sc-l2 (car parsed) (mod-origin label line (mod-form-name (car parsed)))) out)))
(def mod-source-block (source label line)
  (try (rn-check-source source)
    (catch problem (mod-fail (mod-origin label line nil) "while reading source block" problem))))
(def mod-read-blocks (blocks label) (mod-read-blocks-loop blocks label nil))
(def mod-read-blocks-loop (blocks label out)
  (if blocks
    (if (sc-two (car blocks))
      (if (n-magnitude-p (car (car blocks)))
        (if (mod-chars (mod-second (car blocks)))
          (mod-read-blocks-loop (cdr blocks) label
            (n-reverse (mod-read-forms (mod-source-block (mod-second (car blocks)) label (car (car blocks))) label (car (car blocks))) out))
          (mod-fail (mod-unknown) "source block requires characters" nil))
        (mod-fail (mod-unknown) "source block requires decimal starting line" nil))
      (mod-fail (mod-unknown) "invalid source block" nil)) (n-reverse out nil)))
(def mod-unit-valid (unit)
  (if (sc-three unit)
    (if (car unit) (if (id (car unit) t) nil
      (if (id (type (car unit)) 'symbol)
        (if (mod-chars (mod-second unit)) (mod-list (mod-third unit)) nil) nil)) nil) nil))
(def mod-read-unit (unit)
  (if (mod-unit-valid unit) (mod-read-blocks (mod-third unit) (mod-second unit))
    (mod-fail (mod-unknown) "invalid source unit" nil)))
(def mod-simple-chars (xs)
  (if xs (if (rn-member (car xs) "abcdefghijklmnopqrstuvwxyz0123456789-")
    (mod-simple-chars (cdr xs)) nil) t))
(def mod-simple (x)
  (if x (if (id x t) nil (if (id (type x) 'symbol)
    ((fn (chars)
       (if chars (if (rn-member (car chars) "abcdefghijklmnopqrstuvwxyz") (mod-simple-chars chars) nil) nil))
     (nom x)) nil)) nil))
(def mod-binding (x)
  (if (id (type x) 'symbol)
    (if (rn-text-equal (nom x) "/") (sc-name x)
      (if (rn-member \/ (nom x)) nil (sc-name x))) nil))
(def mod-path-characters (path)
  (if path
    ((fn (digits)
       (if (n-less digits "32") nil
         (if (n-equal digits "127") nil (mod-path-characters (cdr path)))))
     (n-numerator (char-code (car path)))) t))
(def mod-path (path)
  (if path (if (mod-chars path)
    (if (rn-member (car path) '(\/ \~)) nil
      (if (rn-member \: path) nil (mod-path-characters path))) nil) nil))
(def mod-import (form origin)
  (if (sc-two form)
    (if (mod-path (mod-second form)) (sc-l3 (mod-second form) nil (mod-second origin))
      (mod-fail origin "import requires a nonempty relative path" nil))
    (if (sc-four form)
      (if (id (mod-third form) 'as)
        (if (mod-simple (mod-fourth form))
          (if (mod-path (mod-second form))
            (sc-l3 (mod-second form) (mod-fourth form) (mod-second origin))
            (mod-fail origin "import requires a nonempty relative path" nil))
          (mod-fail origin "invalid import alias" (mod-fourth form)))
        (mod-fail origin "import syntax requires as" nil))
      (mod-fail origin "invalid import form" nil))))
; Unit info: (id label module-name imports exports located-definitions).
(def mod-unit-info (unit)
  (mod-info-start unit (mod-read-unit unit)))
(def mod-info-start (unit rows)
  (if rows
    (if (if (id (type (car (car rows))) 'pair) (id (car (car (car rows))) 'module) nil)
      (if (sc-two (car (car rows)))
        (if (mod-simple (mod-second (car (car rows))))
          (mod-headers unit (cdr rows) (mod-second (car (car rows))) nil nil nil nil nil)
          (mod-fail (mod-second (car rows)) "invalid module name" nil))
        (mod-fail (mod-second (car rows)) "invalid module declaration" nil))
      (mod-headers unit rows nil nil nil nil nil nil))
    (sc-l6 (car unit) (mod-second unit) nil nil nil nil)))
(def mod-alias-present (alias imports)
  (if imports (if (id alias (mod-second (car imports))) t (mod-alias-present alias (cdr imports))) nil))
(def mod-headers (unit rows module-name imports exports export-seen definitions definition-seen)
  (if rows
    (mod-header unit (car rows) (cdr rows) module-name imports exports export-seen definitions definition-seen)
    (sc-l6 (car unit) (mod-second unit) module-name
      (n-reverse imports nil) exports (n-reverse definitions nil))))
(def mod-header (unit row rest module-name imports exports export-seen definitions definition-seen)
  (if (id (type (car row)) 'pair)
    (if (id (car (car row)) 'module) (mod-fail (mod-second row) "module declaration must be first" nil)
      (if (id (car (car row)) 'import)
        (if (if module-name definition-seen nil) (mod-fail (mod-second row) "module imports must precede definitions" nil)
          (mod-header-import unit rest module-name imports exports export-seen definitions definition-seen
            (mod-import (car row) (mod-second row))))
        (if (id (car (car row)) 'export)
          (if module-name
            (if definition-seen (mod-fail (mod-second row) "exports must precede definitions" nil)
              (if export-seen (mod-fail (mod-second row) "duplicate export declaration" nil)
                (mod-headers unit rest module-name imports
                  (join (mod-second row) (mod-export-names (cdr (car row)) nil (mod-second row))) t definitions definition-seen)))
            (mod-fail (mod-second row) "legacy source cannot declare exports" nil))
          (if (id (car (car row)) 'def)
            (if (mod-at-least (car row) '(t t t t))
              (if (mod-binding (mod-second (car row)))
                (mod-headers unit rest module-name imports exports export-seen (join row definitions) t)
                (mod-fail (mod-second row) "invalid definition name" (mod-second (car row))))
              (mod-fail (mod-second row) "definition requires parameters and body" nil))
            (mod-fail (mod-second row) "top-level source requires declarations or definitions" (car (car row)))))))
    (mod-fail (mod-second row) "top-level source requires a form" nil)))
(def mod-header-import (unit rest module-name imports exports export-seen definitions definition-seen item)
  (if (if (mod-second item) (mod-alias-present (mod-second item) imports) nil)
    (mod-fail (mod-origin (mod-second unit) (mod-third item) nil) "duplicate import alias" (mod-second item))
    (mod-headers unit rest module-name (join item imports) exports export-seen definitions definition-seen)))
(def mod-export-names (names seen origin)
  (if names
    (if (id (type names) 'pair)
      (if (mod-binding (car names))
        (if (sc-member (car names) seen) (mod-fail origin "duplicate export" (car names))
          (mod-export-names (cdr names) (join (car names) seen) origin))
        (mod-fail origin "invalid export name" (car names)))
      (mod-fail origin "export names must form a proper list" nil)) (n-reverse seen nil)))
; Discovery must also serve `rbel read` on arbitrary data/expression source.
; Full declaration/definition validation belongs to linking, not file discovery.
(def mod-scan-unit (unit) (mod-scan-rows (mod-read-unit unit)))
(def mod-scan-rows (rows)
  (if rows
    (if (if (id (type (car (car rows))) 'pair) (id (car (car (car rows))) 'import) nil)
      (join (mod-import (car (car rows)) (mod-second (car rows))) (mod-scan-rows (cdr rows)))
      (mod-scan-rows (cdr rows))) nil))
(def mod-info (unit-id infos)
  (if infos (if (id unit-id (car (car infos))) (car infos) (mod-info unit-id (cdr infos))) nil))
(def mod-infos (units seen)
  (if units
    (if (mod-unit-valid (car units))
      (if (sc-member (car (car units)) seen) (mod-fail (mod-unknown) "duplicate source unit" (car (car units)))
        (join (mod-unit-info (car units)) (mod-infos (cdr units) (join (car (car units)) seen))))
      (mod-fail (mod-unknown) "invalid source unit" nil)) nil))
(def mod-import-origin (info item) (mod-origin (mod-second info) (mod-third item) nil))
(def mod-edge (owner path edges)
  (if edges
    (if (id owner (car (car edges)))
      (if (rn-text-equal path (mod-second (car edges))) (car edges) (mod-edge owner path (cdr edges)))
      (mod-edge owner path (cdr edges))) nil))
(def mod-import-path (path imports)
  (if imports (if (rn-text-equal path (car (car imports))) (car imports)
    (mod-import-path path (cdr imports))) nil))
(def mod-edge-valid (edge infos previous)
  (if (sc-three edge)
    ((fn (owner target)
       (if owner (if target
         (if (mod-import-path (mod-second edge) (mod-fourth owner))
           (if (mod-edge (car edge) (mod-second edge) previous)
             (mod-fail (mod-unknown) "duplicate or contradictory import edge" nil) t)
           (mod-fail (mod-unknown) "edge does not match an authored import" nil))
         (mod-fail (mod-unknown) "edge target is absent" (mod-third edge)))
         (mod-fail (mod-unknown) "edge importer is absent" (car edge))))
     (mod-info (car edge) infos) (mod-info (mod-third edge) infos))
    (mod-fail (mod-unknown) "invalid import edge" nil)))
(def mod-edges-valid (edges infos previous)
  (if edges (if (mod-edge-valid (car edges) infos previous)
    (mod-edges-valid (cdr edges) infos (join (car edges) previous)) nil) t))
(def mod-imports-valid (imports info infos edges)
  (if imports
    ((fn (edge)
       (if edge
         ((fn (target)
            (if (mod-second (car imports))
              (if (mod-third target) (mod-imports-valid (cdr imports) info infos edges)
                (mod-fail (mod-import-origin info (car imports)) "aliased import requires a declared module" (car (car imports))))
              (if (if (mod-third info) t (mod-third target))
                (mod-fail (mod-import-origin info (car imports)) "module imports require an alias" (car (car imports)))
                (mod-imports-valid (cdr imports) info infos edges))))
          (mod-info (mod-third edge) infos))
         (mod-fail (mod-import-origin info (car imports)) "missing dependency edge" (car (car imports)))))
     (mod-edge (car info) (car (car imports)) edges)) t))
(def mod-all-imports-valid (pending infos edges)
  (if pending (if (mod-imports-valid (mod-fourth (car pending)) (car pending) infos edges)
    (mod-all-imports-valid (cdr pending) infos edges) nil) t))
(def mod-reachable (unit-id infos edges active seen)
  (if (sc-member unit-id active) (mod-fail (mod-unknown) "import cycle" unit-id)
    (if (sc-member unit-id seen) seen
      ((fn (info)
         (if info (mod-reach-imports (mod-fourth info) unit-id infos edges (join unit-id active) (join unit-id seen))
           (mod-fail (mod-unknown) "unknown root unit" unit-id)))
       (mod-info unit-id infos)))))
(def mod-reach-imports (imports owner infos edges active seen)
  (if imports
    ((fn (target)
       (if (sc-member target active)
         (mod-fail (mod-import-origin (mod-info owner infos) (car imports)) "import cycle" (car (car imports)))
         (mod-reach-imports (cdr imports) owner infos edges active
           (mod-reachable target infos edges active seen))))
     (mod-third (mod-edge owner (car (car imports)) edges))) seen))
(def mod-reach-roots (roots infos edges seen)
  (if roots (mod-reach-roots (cdr roots) infos edges (mod-reachable (car roots) infos edges nil seen)) seen))
(def mod-all-reached (infos seen)
  (if infos (if (sc-member (car (car infos)) seen) (mod-all-reached (cdr infos) seen)
    (mod-fail (mod-unknown) "unreachable source unit" (car (car infos)))) t))
; Global map entries: (owner original-name generated-name origin original-definition).
(def mod-generated (ordinal) (sym (n-append "sc-global-" ordinal)))
(def mod-own-global (owner name globals)
  (if globals
    (if (id owner (car (car globals)))
      (if (id name (mod-second (car globals))) (car globals) (mod-own-global owner name (cdr globals)))
      (mod-own-global owner name (cdr globals))) nil))
(def mod-legacy-global (name globals infos)
  (if globals
    (if (id name (mod-second (car globals)))
      (if (mod-third (mod-info (car (car globals)) infos)) (mod-legacy-global name (cdr globals) infos) (car globals))
      (mod-legacy-global name (cdr globals) infos)) nil))
(def mod-global-conflict (info name globals infos)
  (if (mod-third info) (mod-own-global (car info) name globals) (mod-legacy-global name globals infos)))
(def mod-build-globals (pending infos globals ordinal)
  (if pending
    (mod-build-definitions (mod-sixth (car pending)) (car pending) (cdr pending) infos globals ordinal)
    (n-reverse globals nil)))
(def mod-build-definitions (rows info pending infos globals ordinal)
  (if rows
    (if (mod-global-conflict info (mod-second (car (car rows))) globals infos)
      (mod-fail (mod-second (car rows)) "duplicate definition" (mod-second (car (car rows))))
      (mod-build-definitions (cdr rows) info pending infos
        (join (sc-l5 (car info) (mod-second (car (car rows))) (mod-generated ordinal)
          (mod-second (car rows)) (car (car rows))) globals) (n-add ordinal "1")))
    (mod-build-globals pending infos globals ordinal)))
(def mod-exports-valid (exports info globals origin)
  (if exports
    (if (mod-own-global (car info) (car exports) globals) (mod-exports-valid (cdr exports) info globals origin)
      (mod-fail origin "export must name an own definition" (car exports))) t))
(def mod-all-exports-valid (infos globals)
  (if infos (if (mod-exports-valid (cdr (mod-fifth (car infos))) (car infos) globals
      (if (mod-fifth (car infos)) (car (mod-fifth (car infos))) (mod-unknown)))
    (mod-all-exports-valid (cdr infos) globals) nil) t))
(def mod-import-alias (alias imports)
  (if imports (if (id alias (mod-second (car imports))) (car imports) (mod-import-alias alias (cdr imports))) nil))
(def mod-split-qualified (chars left)
  (if chars
    (if (id (car chars) \/) (sc-l2 (sym (n-reverse left nil)) (sym (cdr chars)))
      (mod-split-qualified (cdr chars) (join (car chars) left))) nil))
(def mod-qualified-global (parts owner infos edges globals origin)
  ((fn (info)
     ((fn (dependency)
        (if dependency
          ((fn (target)
             (if (sc-member (mod-second parts) (cdr (mod-fifth target)))
               ((fn (binding) (if binding (mod-third binding)
                    (mod-fail origin "unknown exported definition" (mod-second parts))))
                (mod-own-global (car target) (mod-second parts) globals))
               (mod-fail origin "private or unknown export" (mod-second parts))))
           (mod-info (mod-third (mod-edge owner (car dependency) edges)) infos))
          (mod-fail origin "unknown module alias" (car parts))))
      (mod-import-alias (car parts) (mod-fourth info))))
   (mod-info owner infos)))
(def mod-local-site (site name locals)
  (if locals
    (if (id site (car (car locals)))
      (if (id name (mod-second (car locals))) (mod-third (car locals))
        (mod-local-site site name (cdr locals)))
      (mod-local-site site name (cdr locals))) nil))
(def mod-lexical (name bindings)
  (if bindings
    (if (id name (car (car bindings))) (mod-second (car bindings))
      (mod-lexical name (cdr bindings))) nil))
; Local collection state: (site-map next-ordinal definition-prefix origin).
(def mod-local-add (site name state)
  (if (sc-variable name)
    (if (mod-local-site site name (car state)) state
      (sc-l4
        (join (sc-l3 site name
          (sym (n-append "sc-local-" (n-append (mod-third state)
            (n-append "-" (mod-second state)))))) (car state))
        (n-add (mod-second state) "1") (mod-third state) (mod-fourth state)))
    (mod-fail (mod-fourth state) "invalid lexical binding" name)))
(def mod-collect-params (site params state)
  (if params
    (if (id (type params) 'pair)
      (mod-collect-params site (cdr params) (mod-local-add site (car params) state))
      (mod-local-add site params state)) state))
(def mod-collect-list (xs state)
  (if xs
    (if (id (type xs) 'pair) (mod-collect-list (cdr xs) (mod-collect (car xs) state))
      (mod-fail (mod-fourth state) "expression requires a proper list" nil)) state))
(def mod-collect (x state)
  (if (id (type x) 'pair)
    (if (if (sc-integer x) t (sc-chars x)) state
      (if (id (car x) 'quote) state
        (if (id (car x) 'def)
          (mod-collect-list (cdr (cdr (cdr x))) (mod-collect-params x (mod-third x) state))
          (if (id (car x) 'fn)
            (mod-collect-list (cdr (cdr x)) (mod-collect-params x (mod-second x) state))
            (if (id (car x) 'let)
              (mod-collect-list (cdr (cdr x)) (mod-local-add x (mod-second x) state))
              (if (id (car x) 'try)
                (if (if (sc-three x) (sc-three (mod-third x)) nil)
                  (mod-collect-list (cdr x)
                    (mod-local-add (mod-third x) (mod-second (mod-third x)) state))
                  (mod-fail (mod-fourth state) "invalid try form" nil))
                (mod-collect-list x state))))))) state))
(def mod-local-environment (form prefix origin)
  (sc-l2 (car (mod-collect form (sc-l4 nil "0" prefix origin))) nil))
(def mod-bind (site name env origin)
  ((fn (renamed)
     (if renamed (sc-l2 (car env) (join (sc-l2 name renamed) (mod-second env)))
       (mod-fail origin "missing lexical binding site" name)))
   (mod-local-site site name (car env))))
(def mod-renamed-params (site params locals)
  (mod-renamed-params-loop site params locals nil))
(def mod-renamed-params-loop (site params locals out)
  (if params
    (if (id (type params) 'pair)
      (mod-renamed-params-loop site (cdr params) locals
        (join (mod-local-site site (car params) locals) out))
      (n-reverse out (mod-local-site site params locals)))
    (n-reverse out nil)))
(def mod-resolve (name owner env infos edges globals origin)
  (if (if (id name nil) t (id name t)) name
    (if (mod-lexical name (mod-second env)) (mod-lexical name (mod-second env))
      ((fn (qualified)
         (if qualified (mod-qualified-global qualified owner infos edges globals origin)
           ((fn (own)
              (if own (mod-third own)
                (if (mod-third (mod-info owner infos))
                  (if (sc-primitive-name name) name (mod-fail origin "unknown binding" name))
                  ((fn (legacy)
                     (if legacy (mod-third legacy)
                       (if (sc-primitive-name name) name (mod-fail origin "unknown binding" name))))
                   (mod-legacy-global name globals infos)))))
            (mod-own-global owner name globals))))
       (if (id name (sym "/")) nil (mod-split-qualified (nom name) nil))))))
(def mod-parameter (name seen origin)
  (if (sc-variable name)
    (if (sc-member name seen) (mod-fail origin "duplicate parameter" name) (join name seen))
    (mod-fail origin "invalid parameter" name)))
(def mod-parameters (site params seen env origin)
  (if params
    (if (id (type params) 'pair)
      (mod-parameters site (cdr params) (mod-parameter (car params) seen origin)
        (mod-bind site (car params) env origin) origin)
      (if (id (type params) 'symbol)
        (if (mod-parameter params seen origin) (mod-bind site params env origin) nil)
        (mod-fail origin "invalid parameter tail" nil))) env))
(def mod-rewrite-list (xs owner env infos edges globals origin)
  (mod-rewrite-list-loop xs owner env infos edges globals origin nil))
(def mod-rewrite-list-loop (xs owner env infos edges globals origin out)
  (if xs
    (if (id (type xs) 'pair)
      (mod-rewrite-list-loop (cdr xs) owner env infos edges globals origin
        (join (mod-rewrite (car xs) owner env infos edges globals origin) out))
      (mod-fail origin "expression requires a proper list" nil)) (n-reverse out nil)))
(def mod-rewrite-fn (x owner env infos edges globals origin)
  (if (mod-at-least x '(t t t))
    (join 'fn (join (mod-renamed-params x (mod-second x) (car env))
      (mod-rewrite-list (cdr (cdr x)) owner (mod-parameters x (mod-second x) nil env origin) infos edges globals origin)))
    (mod-fail origin "fn requires parameters and a body" nil)))
(def mod-rewrite-let (x owner env infos edges globals origin)
  (if (mod-at-least x '(t t t t))
    (if (sc-variable (mod-second x))
      (join 'let (join (mod-local-site x (mod-second x) (car env))
        (join (mod-rewrite (mod-third x) owner env infos edges globals origin)
          (mod-rewrite-list (cdr (cdr (cdr x))) owner (mod-bind x (mod-second x) env origin) infos edges globals origin))))
      (mod-fail origin "invalid let binding" (mod-second x)))
    (mod-fail origin "let requires a binding, initializer and body" nil)))
(def mod-rewrite-try (x owner env infos edges globals origin)
  (if (sc-three x)
    (if (sc-three (mod-third x))
      (if (id (car (mod-third x)) 'catch)
        (if (sc-variable (mod-second (mod-third x)))
          (sc-l3 'try (mod-rewrite (mod-second x) owner env infos edges globals origin)
            (sc-l3 'catch (mod-local-site (mod-third x) (mod-second (mod-third x)) (car env))
              (mod-rewrite (mod-third (mod-third x)) owner
                (mod-bind (mod-third x) (mod-second (mod-third x)) env origin) infos edges globals origin)))
          (mod-fail origin "invalid catch binding" nil))
        (mod-fail origin "try requires catch" nil))
      (mod-fail origin "invalid catch form" nil))
    (mod-fail origin "invalid try form" nil)))
(def mod-arity-compatible (params arguments)
  (if params
    (if (id (type params) 'pair)
      (if (id (type arguments) 'pair)
        (mod-arity-compatible (cdr params) (cdr arguments)) nil)
      (if (id (type params) 'symbol) (mod-list arguments) nil))
    (id arguments nil)))
(def mod-generated-global (name globals)
  (if globals
    (if (id name (mod-third (car globals))) (car globals)
      (mod-generated-global name (cdr globals))) nil))
(def mod-primitive (name primitives)
  (if primitives
    (if (id name (car (car primitives))) (car primitives)
      (mod-primitive name (cdr primitives))) nil))
(def mod-call-arity (target arguments owner env infos edges globals origin)
  (if (id (type target) 'symbol)
    (if (mod-lexical target (mod-second env)) t
      ((fn (resolved)
         ((fn (binding)
            (if binding
              (if (mod-arity-compatible (mod-third (mod-fifth binding)) arguments) t
                (mod-fail origin "wrong arity in call" target))
              ((fn (primitive)
                 (if primitive
                   (if (mod-arity-compatible (cdr primitive) arguments) t
                     (mod-fail origin "wrong arity in primitive call" target)) t))
               (mod-primitive resolved (sc-primitives)))))
          (mod-generated-global resolved globals)))
       (mod-resolve target owner env infos edges globals origin)))
    (if (id (type target) 'pair)
      (if (id (car target) 'fn)
        (if (mod-arity-compatible (mod-second target) arguments) t
          (mod-fail origin "wrong arity in function call" nil)) t) t)))
(def mod-rewrite-call (x owner env infos edges globals origin)
  (if (mod-call-arity (car x) (cdr x) owner env infos edges globals origin)
    (mod-rewrite-list x owner env infos edges globals origin) nil))
(def mod-rewrite (x owner env infos edges globals origin)
  (if (if (id x nil) t (id x t)) x
    (if (id (type x) 'symbol) (mod-resolve x owner env infos edges globals origin)
      (if (id (type x) 'pair)
        (if (if (sc-integer x) t (sc-chars x)) x
          (if (id (car x) 'quote)
            (if (sc-two x) x (mod-fail origin "quote requires one value" nil))
            (if (id (car x) 'fn) (mod-rewrite-fn x owner env infos edges globals origin)
              (if (id (car x) 'let) (mod-rewrite-let x owner env infos edges globals origin)
                (if (id (car x) 'try) (mod-rewrite-try x owner env infos edges globals origin)
                  (if (if (id (car x) 'if) t (id (car x) 'do))
                    (join (car x) (mod-rewrite-list (cdr x) owner env infos edges globals origin))
                    (mod-rewrite-call x owner env infos edges globals origin))))))) x))))
(def mod-link-definition (binding infos edges globals)
  ((fn (form owner origin)
     ((fn (env)
        (join 'def (join (mod-third binding)
          (join (mod-renamed-params form (mod-third form) (car env))
            (mod-rewrite-list (cdr (cdr (cdr form))) owner
              (mod-parameters form (mod-third form) nil env origin) infos edges globals origin)))))
      (mod-local-environment form (nom (mod-third binding)) origin)))
   (mod-fifth binding) (car binding) (mod-fourth binding)))
(def mod-linked-forms (bindings infos edges globals)
  (mod-linked-forms-loop bindings infos edges globals nil))
(def mod-linked-forms-loop (bindings infos edges globals out)
  (if bindings
    (mod-linked-forms-loop (cdr bindings) infos edges globals
      (join (mod-link-definition (car bindings) infos edges globals) out))
    (n-reverse out nil)))
(def mod-origins (bindings) (mod-origins-loop bindings nil))
(def mod-origins-loop (bindings out)
  (if bindings (mod-origins-loop (cdr bindings) (join (mod-fourth (car bindings)) out))
    (n-reverse out nil)))
(def mod-entry (root infos edges globals active)
  (if (sc-member root active) (mod-fail (mod-unknown) "entry import cycle" root)
    ((fn (info)
       (if (mod-sixth info) (mod-own-global root (mod-second (car (car (mod-sixth info)))) globals)
         (if (mod-third info) (mod-fail (mod-origin (mod-second info) "0" nil) "root module requires an entry definition" nil)
           (mod-entry-imports (mod-fourth info) root infos edges globals (join root active)))))
     (mod-info root infos))))
(def mod-entry-imports (imports owner infos edges globals active)
  (if imports
    ((fn (target)
       (if (mod-third target) (mod-entry-imports (cdr imports) owner infos edges globals active)
         (if (mod-sixth target) (mod-entry (car target) infos edges globals active)
           ((fn (candidate) (if candidate candidate (mod-entry-imports (cdr imports) owner infos edges globals active)))
            (mod-entry-imports (mod-fourth target) (car target) infos edges globals (join (car target) active))))))
     (mod-info (mod-third (mod-edge owner (car (car imports)) edges)) infos)) nil))
(def mod-entry-roots (roots infos edges globals)
  (if roots
    ((fn (entry) (if entry entry (mod-entry-roots (cdr roots) infos edges globals)))
     (mod-entry (car roots) infos edges globals nil)) nil))
(def mod-without (binding globals)
  (if globals (if (id binding (car globals)) (cdr globals) (join (car globals) (mod-without binding (cdr globals)))) nil))
(def mod-legacy-roots (roots infos)
  (if roots
    (if (mod-info (car roots) infos)
      (if (mod-third (mod-info (car roots) infos))
        (mod-fail (mod-unknown) "multiple roots require legacy sources" nil)
        (mod-legacy-roots (cdr roots) infos))
      (mod-fail (mod-unknown) "unknown root unit" (car roots))) t))
(def mod-roots-valid (roots infos)
  (if roots
    (if (cdr roots) (mod-legacy-roots roots infos)
      (if (mod-info (car roots) infos) t (mod-fail (mod-unknown) "unknown root unit" (car roots))))
    (mod-fail (mod-unknown) "source bundle requires a root" nil)))
; Link result: (linked-forms origins infos edges globals).
(def mod-link-bundle (bundle)
  (if (n-five bundle)
    (if (id (car bundle) 'source-bundle-v1)
      (if (if (mod-list (mod-second bundle))
            (if (mod-list (mod-third bundle)) (if (mod-list (mod-fourth bundle)) (mod-list (mod-fifth bundle)) nil) nil) nil)
        (mod-link-infos bundle (mod-infos (mod-third bundle) nil))
        (mod-fail (mod-unknown) "source bundle fields must be lists" nil))
      (mod-fail (mod-unknown) "unknown source bundle version" nil))
    (mod-fail (mod-unknown) "invalid source bundle" nil)))
(def mod-link-infos (bundle infos)
  (if (mod-roots-valid (mod-second bundle) infos)
    (if (mod-edges-valid (mod-fourth bundle) infos nil)
      (if (mod-all-imports-valid infos infos (mod-fourth bundle))
        (if (mod-all-reached infos (mod-reach-roots (mod-second bundle) infos (mod-fourth bundle) nil))
          (mod-link-globals bundle infos (mod-build-globals infos infos nil "0")) nil) nil) nil) nil))
(def mod-link-globals (bundle infos globals)
  (if (mod-all-exports-valid infos globals)
    ((fn (entry)
       (if entry
         ((fn (ordered)
            (sc-l5 (mod-linked-forms ordered infos (mod-fourth bundle) globals)
              (mod-origins ordered) infos (mod-fourth bundle) globals))
          (join entry (mod-without entry globals)))
         (mod-fail (mod-unknown) "no executable entry definition" nil)))
     (mod-entry-roots (mod-second bundle) infos (mod-fourth bundle) globals)) nil))
(def mod-compile-bundle (bundle)
  ((fn (linked) (sc-compile-located (car linked) (mod-second linked))) (mod-link-bundle bundle)))
(def mod-read-example (source origin)
  ((fn (forms)
     (if (sc-one forms) (car forms) (mod-fail origin "example requires exactly one expression/value" nil)))
   (try (rn-read-all source) (catch problem (mod-fail origin "while reading example" problem)))))
(def mod-example-expression (row info linked ordinal)
  ((fn (origin expression)
     (mod-rewrite expression (car row)
       (mod-local-environment expression (n-append "example-" ordinal) origin)
       (mod-third linked) (mod-fourth linked) (mod-fifth linked) origin))
   (mod-origin (mod-second info) (mod-second row) (mod-third row))
   (mod-read-example (mod-fourth row) (mod-origin (mod-second info) (mod-second row) (mod-third row)))))
(def mod-example-present (owner name seen)
  (if seen
    (if (id owner (car (car seen)))
      (if (id name (mod-second (car seen))) t (mod-example-present owner name (cdr seen)))
      (mod-example-present owner name (cdr seen))) nil))
(def mod-examples (examples linked ordinal seen)
  (if examples
    (if (n-five (car examples))
      ((fn (row)
         ((fn (info)
            (if info
              (if (if (n-magnitude-p (mod-second row))
                    (if (id (type (mod-third row)) 'symbol)
                      (if (mod-chars (mod-fourth row)) (mod-chars (mod-fifth row)) nil) nil) nil)
                (if (mod-example-present (car row) (mod-third row) seen)
                  (mod-fail (mod-origin (mod-second info) (mod-second row) (mod-third row)) "duplicate example" (mod-third row))
                  (join (sc-l3 (sym (n-append "mod-example-" ordinal))
                    (mod-example-expression row info linked ordinal)
                    (mod-read-example (mod-fifth row) (mod-origin (mod-second info) (mod-second row) (mod-third row))))
                    (mod-examples (cdr examples) linked (n-add ordinal "1")
                      (join (sc-l2 (car row) (mod-third row)) seen))))
                (mod-fail (mod-unknown) "invalid example metadata/source" nil))
              (mod-fail (mod-unknown) "example owner is absent" (car row))))
          (mod-info (car row) (mod-third linked))))
       (car examples))
      (mod-fail (mod-unknown) "invalid example row" nil)) nil))
(def mod-check-bundle (bundle)
  ((fn (linked)
     (if (mod-fifth bundle)
       (sc-compile-located (rbel-test-module (car linked) (mod-examples (mod-fifth bundle) linked "0" nil))
         (join (mod-unknown) (join (mod-unknown) (mod-second linked))))
       (mod-fail (mod-unknown) "check requires examples" nil)))
   (mod-link-bundle bundle)))
