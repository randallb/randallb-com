; Entry stays first. The host supplies fixture data, never evaluates rbel.
(def bench (mode input)
  (if (id mode 'tail-direct) (bench-tail input)
    (if (id mode 'tail-apply) (bench-apply input)
      (if (id mode 'allocation-churn) (bench-churn input)
        (if (id mode 'list-reverse) (bench-reverse input nil)
          (if (id mode 'exact-arithmetic)
            (integer-text (+ (* 999999999999999 1000000000000000) 1000000000000000))
            (if (id mode 'utf8-roundtrip) (utf8-decode (utf8-encode "hé😉"))
              (err 'unknown-benchmark))))))))
(def bench-tail (xs)
  (if xs (bench-tail (cdr xs)) 'done))
(def bench-apply (xs)
  (if xs (apply bench-apply (join (cdr xs) nil)) 'done))
(def bench-churn (xs)
  (if xs
    (do (join (join 'temporary nil) nil) (bench-churn (cdr xs)))
    'done))
(def bench-reverse (xs out)
  (if xs (bench-reverse (cdr xs) (join (car xs) out)) out))
