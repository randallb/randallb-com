{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared signed grader output v1",
  "description": "0 is ungradable only. Confidence and probabilities are model outputs, not guaranteed calibration. Errors return no grade.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "confidence",
    "probabilities",
    "category",
    "category_probabilities",
    "rubric",
    "rubric_version",
    "model",
    "usage",
    "provider_request_id"
  ],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": -3,
      "maximum": 3,
      "description": "Forced-choice ordinal grade: -3 clear miss; -2 substantial miss; -1 near miss just below the bar; +1 barely meets; +2 solidly meets; +3 strongly meets or exceeds. 0 means ungradable only. Magnitude is not confidence."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "-3",
        "-2",
        "-1",
        "0",
        "1",
        "2",
        "3"
      ],
      "properties": {
        "-3": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "-2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "-1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "3": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "category_probabilities": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provider_request_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
