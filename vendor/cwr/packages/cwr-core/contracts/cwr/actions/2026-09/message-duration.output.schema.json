{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message duration checker shell output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "exit_code",
    "stdout",
    "stderr"
  ],
  "properties": {
    "command": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    }
  }
}
