{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwp://org.coworkerprotocol/2026-09/schemas/action_invocation",
  "title": "Action Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "ref",
    "requester_actor_ref",
    "target_actor_ref",
    "action_name",
    "input",
    "state"
  ],
  "properties": {
    "type": {
      "const": "cwp://org.coworkerprotocol/2026-09/schemas/action_invocation"
    },
    "ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "requester_actor_ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "target_actor_ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "conversation_ref": {
      "description": "The conversation whose visible context applies to this invocation.",
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "action_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*--[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "state": {
      "enum": [
        "admitted",
        "awaiting_person",
        "running",
        "completed",
        "blocked",
        "failed",
        "stopping",
        "stopped"
      ]
    },
    "actor_integration_ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "parent_invocation_ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "source_message_ref": {
      "description": "The conversation message that directly caused this invocation.",
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "timeline_publications": {
      "description": "The append-only decisions keyed by canonical publication ref that describe whether and where this invocation is published.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "format": "cwr-ref",
        "pattern": "^cwp://(?!~)[^\\s#]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/timelineDisposition"
      }
    },
    "input": {
      "description": "The action input, validated by the selected action declaration."
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/action_response"
      },
      "default": []
    },
    "admitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "stop_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "stop_requested_by_actor_ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "dependentRequired": {
    "source_message_ref": [
      "timeline_publications"
    ],
    "timeline_publications": [
      "source_message_ref",
      "conversation_ref"
    ]
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "enum": [
            "admitted",
            "awaiting_person"
          ]
        },
        "responses": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "running"
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/progressResponse"
          }
        }
      },
      "required": [
        "actor_integration_ref"
      ]
    },
    {
      "properties": {
        "state": {
          "const": "completed"
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/progressResponse"
              },
              {
                "$ref": "#/$defs/completedResponse"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/completedResponse"
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": [
        "actor_integration_ref",
        "responses"
      ]
    },
    {
      "properties": {
        "state": {
          "const": "blocked"
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/progressResponse"
              },
              {
                "$ref": "#/$defs/blockedResponse"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/blockedResponse"
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": [
        "actor_integration_ref",
        "responses"
      ]
    },
    {
      "properties": {
        "state": {
          "const": "failed"
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/progressResponse"
              },
              {
                "$ref": "#/$defs/failedResponse"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/failedResponse"
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": [
        "actor_integration_ref",
        "responses"
      ]
    },
    {
      "properties": {
        "state": {
          "enum": [
            "stopping",
            "stopped"
          ]
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/progressResponse"
              },
              {
                "$ref": "#/$defs/stoppedResponse"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/stoppedResponse"
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": [
        "responses"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "started_at"
                ]
              },
              {
                "properties": {
                  "responses": {
                    "contains": {
                      "$ref": "#/$defs/progressResponse"
                    }
                  }
                },
                "required": [
                  "responses"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "actor_integration_ref"
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "timelineDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "root"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parent_item_ref"
          ],
          "properties": {
            "kind": {
              "const": "child"
            },
            "parent_item_ref": {
              "type": "string",
              "format": "cwr-ref",
              "pattern": "^cwp://(?!~)[^\\s#]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "undisclosed"
            }
          }
        }
      ]
    },
    "progressResponse": {
      "allOf": [
        {
          "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/action_response"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "minimum": 100,
              "maximum": 199
            }
          }
        }
      ]
    },
    "completedResponse": {
      "allOf": [
        {
          "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/action_response"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "minimum": 200,
              "maximum": 299
            }
          }
        }
      ]
    },
    "blockedResponse": {
      "allOf": [
        {
          "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/action_response"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "minimum": 400,
              "maximum": 498
            }
          }
        }
      ]
    },
    "failedResponse": {
      "allOf": [
        {
          "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/action_response"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "minimum": 500,
              "maximum": 599
            }
          }
        }
      ]
    },
    "stoppedResponse": {
      "allOf": [
        {
          "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/action_response"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": 499
            }
          }
        }
      ]
    }
  }
}
