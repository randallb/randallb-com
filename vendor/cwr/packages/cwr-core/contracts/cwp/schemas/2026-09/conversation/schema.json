{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwp://org.coworkerprotocol/2026-09/schemas/conversation",
  "title": "Conversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "ref",
    "participant_actor_refs"
  ],
  "properties": {
    "type": {
      "const": "cwp://org.coworkerprotocol/2026-09/schemas/conversation"
    },
    "ref": {
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029](?:[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])?$"
    },
    "participant_actor_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "cwr-ref",
        "pattern": "^(?:~@(?:/[^\\s/#]+)*(?:#[^\\s#]+)?|cwp://(?!~)[^\\s#]+(?:#[^\\s#]+)?)$"
      }
    },
    "timeline_connection_ref": {
      "description": "The authoritative root publication connection. Absence identifies a legacy conversation.",
      "type": "string",
      "format": "cwr-ref",
      "pattern": "^cwp://(?!~)[^\\s#]+$"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "cwp://org.coworkerprotocol/2026-09/schemas/conversation_message"
      }
    }
  }
}
