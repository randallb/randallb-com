{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwp://org.coworkerprotocol/2026-09/schemas",
  "title": "CWR.toml Entry Point",
  "description": "Loads a generic resource graph. The resolver assigns canonical source identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "cwp://org.coworkerprotocol/2026-09/schemas"
    },
    "exports": {
      "$ref": "#/$defs/resourceObjects",
      "default": []
    },
    "imports": {
      "$ref": "#/$defs/resourceObjects",
      "default": []
    },
    "input_schema": {
      "$ref": "#/$defs/resourceObject"
    },
    "inputs": {
      "$ref": "cwp://org.coworkerprotocol/2026-09/schemas#/$defs/inputDeclarations"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_retained_data": {
          "enum": [
            "participants",
            "all"
          ],
          "default": "participants",
          "description": "Allow all callers in this runtime to read its retained data, or require conversation participation."
        }
      }
    }
  },
  "$defs": {
    "resourceObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceObject"
      }
    },
    "resourceObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "A resource declaration path relative to the CWR.toml that contains this object.",
          "type": "string",
          "pattern": "^\\.{1,2}/"
        },
        "ref": {
          "description": "The full CWR ref of an available resource or CWR.toml declaration.",
          "type": "string",
          "format": "cwr-ref",
          "pattern": "^(?:~@(?:/[^\\s/#]+)*|cwp://(?!~)[^\\s#]+)$"
        },
        "as": {
          "description": "An optional contextual namespace in the current root.",
          "type": "string",
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
        },
        "inputs": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "as"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^~@/[A-Za-z0-9_-]+$"
                  },
                  "as": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          ],
          "default": {}
        }
      },
      "oneOf": [
        {
          "properties": {
            "path": {}
          },
          "required": [
            "path"
          ]
        },
        {
          "properties": {
            "ref": {}
          },
          "required": [
            "ref"
          ]
        }
      ]
    },
    "inputDeclarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "storage"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "cwp://org.coworkerprotocol/2026-09/schemas/plaintext"
                }
              }
            }
          }
        ],
        "required": [
          "type",
          "as"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "as": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "purpose": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "storage": {
            "description": "Host-local storage mode for plaintext inputs. Omission preserves the local JSON configuration editor.",
            "enum": [
              "local_json",
              "workspace_variable"
            ]
          }
        }
      }
    },
    "volumeDeclarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "as",
          "access"
        ],
        "properties": {
          "as": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "access": {
            "enum": [
              "read",
              "read_write"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "not": {
    "required": [
      "inputs",
      "input_schema"
    ]
  }
}
