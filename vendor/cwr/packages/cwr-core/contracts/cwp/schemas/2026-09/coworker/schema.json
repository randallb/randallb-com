{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwp://org.coworkerprotocol/2026-09/schemas/coworker",
  "title": "Coworker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "name"
  ],
  "properties": {
    "type": {
      "const": "cwp://org.coworkerprotocol/2026-09/schemas/coworker"
    },
    "exports": {
      "$ref": "#/$defs/resourceObjects",
      "default": []
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coworkerImport"
      },
      "default": []
    },
    "input_schema": {
      "$ref": "#/$defs/resourceObject"
    },
    "name": {
      "description": "An optional display name.",
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "description": "The lowercase snake-case subject name used to project this coworker's actions into tool names.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "authority": {
      "description": "Actual coworker grants. Role requirements do not grant authority.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/authorityEffect"
      },
      "default": []
    },
    "roles": {
      "$ref": "#/$defs/resourceObjects"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "A resource declaration path relative to the CWR.toml that contains this object.",
            "type": "string",
            "pattern": "^\\.{1,2}/"
          },
          "ref": {
            "description": "The full CWR ref of an available resource or CWR.toml declaration.",
            "type": "string",
            "format": "cwr-ref",
            "pattern": "^(?:~@(?:/[^\\s/#]+)*|cwp://(?!~)[^\\s#]+)$"
          },
          "as": {
            "description": "An optional contextual namespace in the current root.",
            "type": "string",
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
          },
          "inputs": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "as"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^~@/[A-Za-z0-9_-]+$"
                    },
                    "as": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              }
            ],
            "default": {}
          },
          "default": {
            "type": "boolean",
            "default": false
          },
          "message_mode": {
            "enum": [
              "conversational",
              "actions_only"
            ]
          },
          "params": {
            "type": "object",
            "default": {}
          }
        },
        "oneOf": [
          {
            "properties": {
              "path": {}
            },
            "required": [
              "path"
            ]
          },
          {
            "properties": {
              "ref": {}
            },
            "required": [
              "ref"
            ]
          }
        ],
        "required": [
          "as"
        ]
      }
    },
    "native_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "coworker",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "coworker": {
            "type": "string",
            "format": "cwr-ref"
          },
          "action": {
            "type": "string"
          },
          "binding": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "$ref": "cwp://org.coworkerprotocol/2026-09/schemas#/$defs/inputDeclarations"
    },
    "message_binding_preference": {
      "description": "Opt-in ordered binding names for new messages without an explicit binding. First must be the default. Actions retain exact targets.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "resourceObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceObject"
      }
    },
    "resourceObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "A resource declaration path relative to the CWR.toml that contains this object.",
          "type": "string",
          "pattern": "^\\.{1,2}/"
        },
        "ref": {
          "description": "The full CWR ref of an available resource or CWR.toml declaration.",
          "type": "string",
          "format": "cwr-ref",
          "pattern": "^(?:~@(?:/[^\\s/#]+)*|cwp://(?!~)[^\\s#]+)$"
        },
        "as": {
          "description": "An optional contextual namespace in the current root.",
          "type": "string",
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
        },
        "inputs": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "as"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^~@/[A-Za-z0-9_-]+$"
                  },
                  "as": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          ],
          "default": {}
        }
      },
      "oneOf": [
        {
          "properties": {
            "path": {}
          },
          "required": [
            "path"
          ]
        },
        {
          "properties": {
            "ref": {}
          },
          "required": [
            "ref"
          ]
        }
      ]
    },
    "authorityEffect": {
      "type": "string",
      "enum": [
        "workspace.read",
        "workspace.write",
        "process.execute",
        "cwr:configure"
      ]
    },
    "coworkerImport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "A resource declaration path relative to the CWR.toml that contains this object.",
          "type": "string",
          "pattern": "^\\.{1,2}/"
        },
        "ref": {
          "description": "The full CWR ref of an available resource or CWR.toml declaration.",
          "type": "string",
          "format": "cwr-ref",
          "pattern": "^(?:~@(?:/[^\\s/#]+)*|cwp://(?!~)[^\\s#]+)$"
        },
        "as": {
          "description": "An optional contextual namespace in the current root.",
          "type": "string",
          "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
        },
        "inputs": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "as"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^~@/[A-Za-z0-9_-]+$"
                  },
                  "as": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            }
          ],
          "default": {}
        },
        "default_conversation_target": {
          "description": "Preselect this imported coworker for new conversations started by the declaring coworker. At most one import may set this to true.",
          "type": "boolean",
          "default": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "path": {}
          },
          "required": [
            "path"
          ]
        },
        {
          "properties": {
            "ref": {}
          },
          "required": [
            "ref"
          ]
        }
      ]
    }
  },
  "not": {
    "required": [
      "inputs",
      "input_schema"
    ]
  }
}
