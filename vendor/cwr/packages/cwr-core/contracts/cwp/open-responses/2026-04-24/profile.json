      "cwp_action_ref",
      "cwp_invocation_ref",
      "cwr_model_run_ref",
      "open_responses_item_id",
      "function_call_id"
    ],
    "must_not_be_inferred_from_cwp_lifecycle": true
  },
  "exclusions": [
    "response.completed",
    "all_response_resource_lifecycle_events",
    "ResponseResource",
    "FunctionCallOutput_as_provider_output_including_explicit_echoes",
