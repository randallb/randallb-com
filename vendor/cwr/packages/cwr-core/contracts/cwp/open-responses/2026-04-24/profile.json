  "ordering": [
    {
      "id": "sequence_numbers_increase",
      "rule": "sequence_number strictly increases within one provider response stream"
    },
    {
      "id": "output_item_lifecycle",
      "rule": "response.output_item.added opens a unique output_index and item.id; response.output_item.done closes the same item after its content completes and its message content agrees with authoritative output_text.done values"
    },
    {
      "id": "content_part_lifecycle",
      "rule": "response.content_part.added opens a unique item_id/output_index/content_index tuple after its message item starts; response.content_part.done closes it after output text completes and part.text agrees with authoritative output_text.done text"
    },
    {
      "id": "output_text_lifecycle",
      "rule": "zero or more response.output_text.delta events occur between content_part.added and one response.output_text.done for the same tuple; done.text is authoritative and may repair or replace accumulated delta text"
    },
    {
      "id": "phase_by_item_identity",
      "rule": "assistant phase is retained on Message.id and must agree between item added and done; deltas inherit classification only through the matching item identity"
    },
    {
      "id": "function_calls_have_no_argument_delta_lifecycle",
      "rule": "FunctionCall arguments are complete on item events because function argument delta and done events are excluded"
    },
    {
      "id": "error_terminates",
      "rule": "error may terminate an open item or content part and no supported event follows it"
    }
  ],
  "validation": {
    "layers": [
      {
        "name": "pinned_schema",
        "rule": "Validate the whole value against its referenced component in openapi.json."
      },
      {
        "name": "cwp_profile",
        "rule": "Reject unlisted fields, union members, content kinds, event types, directions, and orderings; enforce profile identity constraints."
      }
    ],
    "unknown_provider_data": "bounded_privacy_filtered_diagnostics_only",
    "unknown_data_is_model_text": false
  },
  "continuation": {
