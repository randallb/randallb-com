{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwp://org.coworkerprotocol/2026-10-23/schemas/native-service",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "ref",
    "provider",
    "operations",
    "entities"
  ],
  "properties": {
    "type": {
      "const": "cwp://org.coworkerprotocol/2026-10-23/schemas/native-service"
    },
    "ref": {
      "const": "cwp://org.coworkerprotocol/cwr/services/conversations"
    },
    "provider": {
      "const": "cwr.conversations.v1"
    },
    "operations": {
      "const": [
        "publish",
        "timeline",
        "message",
        "archive",
        "restore",
        "stop",
        "replay",
        "ingress",
        "list",
        "browse",
        "rename",
        "export",
        "import",
        "fork"
      ]
    },
    "entities": {
      "const": [
        "conversation",
        "conversation-message",
        "conversation-activity",
        "conversation-transfer-metadata",
        "conversation-timeline-connection",
        "conversation-timeline-item",
        "conversation-participation"
      ]
    }
  }
}
