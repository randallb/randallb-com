{
  "type": "object",
  "required": [
    "type",
    "ref",
    "relationships"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "cwp://org.coworkerprotocol/2026-10-23/schemas/relationship-catalog"
    },
    "ref": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "target",
          "singleton",
          "ordered",
          "derived",
          "value_schema"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "runtime",
                "conversation",
                "message",
                "activity",
                "invocation",
                "conversation_transfer_metadata",
                "conversation_timeline_connection",
                "conversation_timeline_item",
                "external:actor",
                "binding:activity",
                "binding:projection_item",
                "edge:timeline_activity",
                "binding:invocation"
              ]
            }
          },
          "target": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "runtime",
                "conversation",
                "message",
                "activity",
                "invocation",
                "conversation_transfer_metadata",
                "conversation_timeline_connection",
                "conversation_timeline_item",
                "external:actor",
                "binding:activity",
                "binding:projection_item",
                "edge:timeline_activity",
                "binding:invocation"
              ]
            }
          },
          "singleton": {
            "type": "boolean"
          },
          "ordered": {
            "type": "boolean"
          },
          "derived": {
            "type": "boolean"
          },
          "value_schema": {
            "type": "object"
          }
        }
      }
    }
