# Evaluate only shell inputs: exclude source, build output and local secrets
# from the path flake copied into the Nix store. Keep the root lock authoritative.
evals_inputs="code/apps/eval-runner/default.nix code/apps/eval-runner/image.nix code/apps/eval-runner/cli.py code/apps/eval-runner/lifecycle.py code/apps/eval-runner/builder.py code/apps/eval-runner/guest.py"
watch_file flake.nix flake.lock code/rust-toolchain.toml $evals_inputs
mkdir -p .direnv/shell-source/code
for shell_input in flake.nix flake.lock code/rust-toolchain.toml $evals_inputs; do
  mkdir -p ".direnv/shell-source/$(dirname "$shell_input")"
  if ! cmp -s "$shell_input" ".direnv/shell-source/$shell_input"; then
    cp "$shell_input" ".direnv/shell-source/$shell_input"
  fi
done
unset shell_input evals_inputs
use flake "path:./.direnv/shell-source" --no-update-lock-file
