# Evaluate only shell inputs: exclude source, build output and local secrets
# from the path flake copied into the Nix store. Keep the root lock authoritative.
watch_file flake.nix flake.lock code/rust-toolchain.toml
mkdir -p .direnv/shell-source/code
for shell_input in flake.nix flake.lock code/rust-toolchain.toml; do
  if ! cmp -s "$shell_input" ".direnv/shell-source/$shell_input"; then
    cp "$shell_input" ".direnv/shell-source/$shell_input"
  fi
done
unset shell_input
use flake "path:./.direnv/shell-source" --no-update-lock-file
